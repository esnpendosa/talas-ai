# ============================================================
# TALAS AI — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environment
venv/
env/
ENV/
.venv/
.env.local
.env.production

# Environment variables — JANGAN commit secrets
.env
# .env.example boleh di-commit (tidak mengandung secrets)

# Database — jangan commit database production
data/talas.db
data/test_talas.db
data/*.db
data/documents/*
data/indexes/*
data/exports/*
data/backups/*

# Kecuali .gitkeep untuk menjaga struktur folder
!data/documents/.gitkeep
!data/indexes/.gitkeep
!data/exports/.gitkeep
!data/backups/.gitkeep

# Logs
logs/*.log
logs/*.log.*

# Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Distribution / packaging
.Python
build/
dist/

# PyInstaller
*.manifest
*.spec

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Windows
desktop.ini
$RECYCLE.BIN/

# Jupyter
.ipynb_checkpoints

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Type checking
.pytype/

# Antigravity (skills folder)
.antigravity/
