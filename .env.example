# ============================================================
# TALAS AI — Environment Configuration Example
# Copy this file to .env and adjust values accordingly
# JANGAN memasukkan nilai production ke file ini
# ============================================================

# Application
APP_NAME="TALAS AI"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Telaah Regulasi Berbasis Artificial Intelligence"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

# Server
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Database
DATABASE_URL=sqlite:///./data/talas.db
DATABASE_ECHO=false

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# File Storage
UPLOAD_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,doc

# AI Privacy Mode
# Options: local_only, cloud_allowed, ask_before_sending
DEFAULT_AI_MODE=local_only

# Local AI Providers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
OLLAMA_ENABLED=true

LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_TIMEOUT=120
LMSTUDIO_ENABLED=false

LLAMACPP_BASE_URL=
LLAMACPP_ENABLED=false

# Cloud AI (disabled by default — requires explicit user permission)
CLOUD_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Default Models (will be overridden by user selection)
DEFAULT_CHAT_MODEL=
DEFAULT_EMBEDDING_MODEL=
DEFAULT_LEGAL_BASIS_MODEL=
DEFAULT_CONFLICT_MODEL=
DEFAULT_CONSISTENCY_MODEL=

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Backup
BACKUP_DIR=./data/backups
MAX_BACKUPS=10

# Indexes
INDEX_DIR=./data/indexes

# Exports
EXPORT_DIR=./data/exports

# RAG Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_RETRIEVAL_RESULTS=10
MIN_SIMILARITY_SCORE=0.3

# Feature Flags
ENABLE_OCR=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_AUDIT_LOG=true
FIRST_RUN=true
